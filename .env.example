# Countersign — copy to `.env` (never commit `.env`).
# Values below are safe defaults for local development against Concordium TESTNET.

# ---------------------------------------------------------------------------
# Concordium (testnet only — mainnet is refused by config validation)
# ---------------------------------------------------------------------------
CONCORDIUM_NETWORK=testnet
CONCORDIUM_GRPC_HOST=grpc.testnet.concordium.com
CONCORDIUM_GRPC_PORT=20000
CONCORDIUM_GRPC_TLS=true

# CIS-8004 Agent Registry on testnet (from the hosted registry's `contract_info`, 2026-11-11)
CIS8004_CONTRACT_INDEX=12802
CIS8004_CONTRACT_SUBINDEX=0
# CIS-8 External Key Registry on testnet
CIS8_CONTRACT_INDEX=12801
CIS8_CONTRACT_SUBINDEX=0

# Concordium's hosted Agent Registry service (REST + MCP). Used by spikes and as an optional
# cross-check; the trust service's verdict reads the chain directly.
AGENT_REGISTRY_API_URL=https://agent-registry-mcp.concordium.com

# Service account used ONLY to pay for anchoring (verification requests, audit records,
# Trust Receipts). Low balance, testnet CCD. Path to the key file exported from the
# Concordium Browser Wallet (Settings → Export private key → `<name>.export`).
# This is NOT a merchant wallet: merchants always sign in their own wallet.
ANCHOR_WALLET_EXPORT_PATH=./secrets/anchor-account.export

# Set to 1 to run integration tests that hit testnet (needs gRPC reachability + funded anchor key).
CONCORDIUM_INTEGRATION=0

# ---------------------------------------------------------------------------
# Trust service
# ---------------------------------------------------------------------------
TRUST_SERVICE_PORT=4000
TRUST_SERVICE_PUBLIC_URL=http://localhost:4000
DATABASE_URL=postgres://countersign:countersign@localhost:5432/countersign
REDIS_URL=redis://localhost:6379
VERDICT_CACHE_TTL_SECONDS=30
# Salt for hashing buyer references on receipts (generate: openssl rand -hex 32)
BUYER_REF_HASH_SALT=change-me

# ---------------------------------------------------------------------------
# Web app (Next.js)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_TRUST_SERVICE_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Reown (WalletConnect) project id — https://cloud.reown.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ---------------------------------------------------------------------------
# Seller agent (Phase 3)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
