{
  "name": "@countersign/trust-service",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "tsx --env-file-if-exists=../../.env src/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "spike": "tsx --env-file-if-exists=../../.env scripts/spike/all.ts",
    "spike:registry": "tsx --env-file-if-exists=../../.env scripts/spike/registry.ts",
    "spike:proof": "tsx --env-file-if-exists=../../.env scripts/spike/proof.ts",
    "spike:anchor": "tsx --env-file-if-exists=../../.env scripts/spike/anchor.ts",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@concordium/web-sdk": "12.0.2",
    "@countersign/shared": "workspace:*",
    "@fastify/cors": "11.4.3",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11"
  }
}
